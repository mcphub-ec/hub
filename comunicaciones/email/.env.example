# Email MCP Server
# Copy this file to .env and fill in real values before use.
#   cp .env.example .env && chmod 600 .env

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT_MODE=sse

# Required for prepare_email/send_prepared_email HMAC confirmation tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_MASTER_KEY=

# Comma-separated account IDs. Account IDs are normalized to uppercase env prefixes.
EMAIL_ACCOUNTS=personal,trabajo

# PERSONAL account
EMAIL_PERSONAL_IMAP_HOST=imap.example.com
EMAIL_PERSONAL_IMAP_PORT=993
EMAIL_PERSONAL_IMAP_USER=user@example.com
EMAIL_PERSONAL_IMAP_PASSWORD=
EMAIL_PERSONAL_SMTP_HOST=smtp.example.com
EMAIL_PERSONAL_SMTP_PORT=587
EMAIL_PERSONAL_SMTP_USER=user@example.com
EMAIL_PERSONAL_SMTP_PASSWORD=
EMAIL_PERSONAL_FROM=user@example.com
EMAIL_PERSONAL_TLS_MODE=starttls

# TRABAJO account
EMAIL_TRABAJO_IMAP_HOST=imap.example.com
EMAIL_TRABAJO_IMAP_PORT=993
EMAIL_TRABAJO_IMAP_USER=work@example.com
EMAIL_TRABAJO_IMAP_PASSWORD=
EMAIL_TRABAJO_SMTP_HOST=smtp.example.com
EMAIL_TRABAJO_SMTP_PORT=587
EMAIL_TRABAJO_SMTP_USER=work@example.com
EMAIL_TRABAJO_SMTP_PASSWORD=
EMAIL_TRABAJO_FROM=work@example.com
EMAIL_TRABAJO_TLS_MODE=starttls

# Safety limits
EMAIL_SEARCH_LIMIT_DEFAULT=20
EMAIL_SEARCH_LIMIT_MAX=100
MAX_BODY_CHARS=20000
MAX_ATTACHMENT_BYTES=5000000
